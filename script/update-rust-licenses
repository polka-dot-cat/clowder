#!/usr/bin/env bash
# Refresh notices after a Rust dependency update; not required for normal builds.
set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.."

tool="${CARGO_ABOUT:-cargo-about}"
if [[ "$("$tool" --version)" != 'cargo-about 0.9.2' ]]; then
    echo 'Install cargo-about 0.9.2 with: cargo install cargo-about --version 0.9.2 --features cli --locked' >&2
    exit 1
fi

# Some crates omit their license files. about.toml pins repository file hashes;
# cargo-about retrieves those files at the source commits recorded in the crates.
cargo fetch --locked
notices=$(mktemp "${TMPDIR:-/tmp}/clowder-notices.XXXXXX")
trap 'rm -f "$notices"' EXIT
"$tool" generate --locked --fail docs/rust-licenses.hbs --output-file "$notices"
if command -v sha256sum >/dev/null 2>&1; then
    digest=$(sha256sum Cargo.lock | cut -d ' ' -f 1)
else
    digest=$(shasum -a 256 Cargo.lock | cut -d ' ' -f 1)
fi
{
    printf '<!-- Cargo.lock SHA-256: %s -->\n\n' "$digest"
    # Keep upstream text while normalizing CRLF and trailing empty lines.
    awk '{ sub(/\r$/, ""); lines[NR] = $0 }
         END { while (NR && lines[NR] == "") NR--;
               for (i = 1; i <= NR; i++) print lines[i] }' "$notices"
} > THIRD-PARTY-NOTICES.md
echo 'Updated THIRD-PARTY-NOTICES.md'
