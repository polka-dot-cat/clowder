#!/usr/bin/env python3
"""Embed shared CLI grammar and schema without runtime resource bundles."""
import argparse
from pathlib import Path
root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
text = '// Generated by script/update-swift-resources. Edit the shared JSON sources.\n'
text += 'enum Embedded {\n'
for key, source in [('grammar', 'src/cli_spec.json'), ('schema', 'clowder/clowder.schema.json')]:
    text += '    static let ' + key + ' = #"""\n' + (root / source).read_text().rstrip() + '\n"""#\n'
text += '}\n'
target = root / 'swift/Sources/ClowderCore/Embedded.swift'
if args.check:
    if target.read_text() != text:
        raise SystemExit('Swift resources are stale; run script/update-swift-resources')
else:
    target.write_text(text)
