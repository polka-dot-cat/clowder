#!/usr/bin/env python3
"""Build/run credential-free Linux validation without changing host settings."""
import argparse
import json
import subprocess
import shutil
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SUITES = ("read", "write", "schema", "schema-lfs", "ssh-features", "lfs", "offline", "offline-write", "source-urls")
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("suite", choices=("build", "all", *SUITES))
parser.add_argument("--implementation", choices=("rust", "swift"), default="swift")
parser.add_argument("--image")
parser.add_argument("--reports", type=Path)
args = parser.parse_args()
args.reports = args.reports or ROOT / "build" / "isolated" / args.implementation
args.image = args.image or ("clowder-swift-tests:local" if args.implementation == "swift" else "clowder-native-tests:local")
if args.suite == "build":
    # Include current tracked/unignored files, but no .git, credentials, host
    # build output, or disposable test trees. Preserve symlinks without following.
    names = subprocess.check_output(["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"], cwd=ROOT)
    with tempfile.TemporaryDirectory(prefix="clowder-test-context-") as context:
        for name in sorted(set(names.decode().split("\0")) - {""}):
            path = ROOT / name
            if path.is_file() or path.is_symlink():
                destination = Path(context) / name
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(path, destination, follow_symlinks=False)
        subprocess.run(["docker", "build", "-t", args.image, "-f", str(Path(context) / ("tests/isolation/Dockerfile.swift" if args.implementation == "swift" else "tests/isolation/Dockerfile")), context],
                       check=True)

else:
    reports = args.reports.resolve()
    reports.mkdir(parents=True, exist_ok=True)
    image_id = subprocess.check_output(["docker", "image", "inspect", args.image, "--format", "{{.Id}}"], text=True).strip()
    (reports / "image.json").write_text(json.dumps({"implementation": args.implementation,
                                                  "tag": args.image, "id": image_id}, indent=2) + "\n")
    failures = []
    for suite in SUITES if args.suite == "all" else (args.suite,):
        print("Running isolated suite: " + suite, flush=True)
        command = ["docker", "run", "--rm", "--init", "--mount", "type=bind,src=" + str(reports) + ",dst=/reports"]
        if suite in ("write", "source-urls"):
            command += ["--network", "none"]
        if suite in ("write", "offline", "offline-write"):
            command += ["--cap-add", "NET_ADMIN"]
        result = subprocess.run([*command, image_id, suite])
        if result.returncode:
            failures.append(suite)
    if failures:
        raise SystemExit("Failed isolated suites: " + ", ".join(failures))
